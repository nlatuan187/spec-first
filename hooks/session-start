#!/usr/bin/env bash
# spec-first SessionStart hook
# Injects v2 methodology reminder, active spec stage, KNOWLEDGE.md,
# session state, and a warning for any spec shipped but not reconciled.
# Installed to .claude/spec-first/ by install.sh

set -euo pipefail

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# ── Core reminder ─────────────────────────────────────────────────────────────

context="<spec-first-active>
<IMPORTANT>
spec-first v2 is active. Three artifacts govern every change:

  specs/<slug>.md       — written BEFORE the code (prediction; expires at reconcile)
  docs/system/<area>.md — written AFTER the code  (observation; corrected, never deleted)
  KNOWLEDGE.md          — written when you discover something (permanent)

Loop: Clarify → Verify (eight checks, verify.md) → Spec → Approve (human only, never an
      agent) → Build (fresh session) → Review (different session) → Reconcile (within one
      working day of merge: correct the spec against the merged diff, fold durable parts
      into docs/system/<area>.md, set reconciled_at).

On brownfield code: write docs/system/<area>.md from the code first, then spec the
change against it. Do not start with a spec on code nobody has described.

Gate: no source edit without a spec whose status is approved or implementing and whose
      ## File changes names the file. Emergency: touch .spec-first-bypass, fix, write
      the retroactive spec the same day.
</IMPORTANT>"

# ── Scan specs/ for current work and unreconciled specs ──────────────────────

SPECS_DIR="$(pwd)/specs"
if [ -d "$SPECS_DIR" ]; then
  active_specs=""
  unreconciled_specs=""
  guards=""
  for f in "$SPECS_DIR"/*.md; do
    [ -e "$f" ] || continue
    slug=$(basename "$f" .md)
    header=$(sed -n '1,25p' "$f")
    st=$(printf '%s' "$header" | sed -n 's/^status:[[:space:]]*\([a-z-]*\).*/\1/p' | head -1)
    # Guards of a spec being built are the first thing a long session loses.
    # Re-inject them verbatim on every session start, resume and compaction.
    case "$st" in
      approved|implementing)
        # One pass: from "## Guards" to the next heading that is not inside a fenced
        # block, dropping HTML comments and blank lines.
        g=$(tr -d '\r' < "$f" | awk '
          !inside && /^## Guards$/ { inside = 1; next }
          !inside { next }
          /^(```|~~~)/ { fence = !fence; print; next }
          !fence && /^## / { exit }
          /<!--/ { comment = 1 }
          comment { if (/-->/) comment = 0; next }
          /^[ \t]*$/ { next }
          { print }')
        [ -n "$g" ] && guards="${guards}${slug}:"$'\n'"${g}"$'\n\n'
        ;;
    esac
    shipped=$(printf '%s' "$header" | sed -n 's/^shipped_at:[[:space:]]*\([0-9][^[:space:]]*\).*/\1/p' | head -1)
    reconciled=$(printf '%s' "$header" | sed -n 's/^reconciled_at:[[:space:]]*\([0-9][^[:space:]]*\).*/\1/p' | head -1)
    case "$st" in
      draft|in-review|approved|implementing)
        active_specs="${active_specs}  ${slug} — ${st}"$'\n'
        ;;
    esac
    if [ -n "$shipped" ] && [ -z "$reconciled" ]; then
      unreconciled_specs="${unreconciled_specs}  ${slug} — shipped ${shipped}, not yet reconciled"$'\n'
    fi
  done
  if [ -n "$active_specs" ]; then
    context+="

<current-work>
Active specs (derived from specs/ front matter):
${active_specs}</current-work>"
  fi
  if [ -n "$guards" ]; then
    context+="

<guards>
Rulings and hazards from the spec being built. These are decisions already made — do not
re-open them, do not re-derive them, and carry them into every subagent prompt:

${guards}</guards>"
  fi
  if [ -n "$unreconciled_specs" ]; then
    context+="

<reconciliation-overdue>
WARNING — shipped but not reconciled. Complete within one working day of merge:
${unreconciled_specs}
Reconcile: re-read spec against merged diff → correct paths and symbols → append to
## Known issues → fold durable parts into docs/system/<area>.md → set reconciled_at.
</reconciliation-overdue>"
  fi
fi

# ── Inject KNOWLEDGE.md if it exists ─────────────────────────────────────────

KNOWLEDGE_FILE="$(pwd)/KNOWLEDGE.md"
if [ -f "$KNOWLEDGE_FILE" ] && [ -s "$KNOWLEDGE_FILE" ]; then
  knowledge=$(cat "$KNOWLEDGE_FILE")
  context+="

<project-knowledge>
Patterns and lessons discovered in this codebase — read before writing any code:

${knowledge}
</project-knowledge>"
fi

# ── Inject session state if it exists ────────────────────────────────────────

SESSION_STATE="$(pwd)/.claude/session-state.md"
if [ -f "$SESSION_STATE" ] && [ -s "$SESSION_STATE" ]; then
  state=$(cat "$SESSION_STATE")
  context+="

<previous-session>
State from last session — continue from here:

${state}
</previous-session>"
fi

context+="
</spec-first-active>"

escaped=$(escape_for_json "$context")

# ── Output platform-appropriate JSON ─────────────────────────────────────────
# Claude Code sets CLAUDE_PLUGIN_ROOT; Cursor sets CURSOR_PLUGIN_ROOT.
# Other platforms fall back to additional_context.

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context": "%s"}\n' "$escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$escaped"
else
  printf '{"additional_context": "%s"}\n' "$escaped"
fi

exit 0
