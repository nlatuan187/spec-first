#!/usr/bin/env bash
# spec-first enforcement — PreToolUse hook
#
# Blocks edits to source files unless an APPROVED spec claims that file.
#
# Three conditions must all hold for an edit to pass:
#   1. an active spec exists in specs/            (a spec was written)
#   2. its status is approved or implementing     (a human signed off)
#   3. it names the file being edited             (that spec is about THIS file)
#
# Condition 2 is the part no other spec-driven toolchain enforces mechanically.
# Condition 3 is what stops one spec from unlocking the whole repository forever.
#
# Disable: SPEC_FIRST_ENFORCEMENT=off  ·  touch .spec-first-bypass
# Installed to .claude/spec-first/ by install.sh

set -uo pipefail

[ "${SPEC_FIRST_ENFORCEMENT:-}" = "off" ] && exit 0

# ── Parse the tool call ───────────────────────────────────────────────────
# Claude Code pipes JSON: { tool_name, tool_input: { file_path }, cwd }

INPUT=$(cat)
FILE_PATH=""
CWD=""

if command -v jq >/dev/null 2>&1; then
  FILE_PATH=$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
  CWD=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
elif command -v python3 >/dev/null 2>&1; then
  PARSED=$(printf '%s' "$INPUT" | python3 -I -c '
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get("tool_input", {}).get("file_path", ""))
    print(d.get("cwd", ""))
except Exception:
    print(""); print("")
' 2>/dev/null)
  FILE_PATH=$(printf '%s' "$PARSED" | sed -n '1p')
  CWD=$(printf '%s' "$PARSED" | sed -n '2p')
else
  # No JSON parser. Fall back to a narrow extraction rather than failing open
  # silently — a hook that cannot read its input must say so.
  FILE_PATH=$(printf '%s' "$INPUT" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  CWD=$(printf '%s' "$INPUT" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
fi

# Genuinely cannot tell what is being edited — allow, but do not pretend this was a pass.
if [ -z "$FILE_PATH" ] || [ -z "$CWD" ]; then
  echo "spec-first: could not read the tool call; enforcement skipped for this edit." >&2
  exit 0
fi

[ -f "${CWD}/.spec-first-bypass" ] && exit 0

# Canonicalize FILE_PATH to a project-relative path.
# Collapsing '../' prevents traversal attacks like src/auth/../payments/stripe.ts
# from bypassing prefix matching or test-exclusion patterns (findings 2 and 3).
if command -v python3 >/dev/null 2>&1; then
  REL_PATH=$(python3 -I -c "
import os, sys
fp, cwd = sys.argv[1], sys.argv[2]
if not os.path.isabs(fp):
    fp = os.path.join(cwd, fp)
fp = os.path.realpath(fp) if os.path.exists(fp) else os.path.normpath(fp)
rel = os.path.relpath(fp, cwd)
print('' if rel.startswith('..') else rel)
" "$FILE_PATH" "$CWD" 2>/dev/null)
else
  # No python3: literal prefix strip; does not collapse traversal sequences.
  REL_PATH="${FILE_PATH#"${CWD}"/}"
fi

[ -z "$REL_PATH" ] || [ "$REL_PATH" = "$FILE_PATH" ] && exit 0  # outside the project

# ── Test files are always allowed ─────────────────────────────────────────
# Anchored on path segments and real suffixes, so `src/contest/page.tsx` and
# `lib/latest.ts` are NOT treated as tests.

case "/$REL_PATH" in
  */test/*|*/tests/*|*/__tests__/*|*/__mocks__/*|*/spec/*) exit 0 ;;
esac
case "$REL_PATH" in
  *.test.*|*.spec.*|*_test.*|test_*.py) exit 0 ;;
esac

# ── Only source files are gated ───────────────────────────────────────────

case "$REL_PATH" in
  *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) ;;
  *.py|*.pyx)                        ;;
  *.go|*.rs|*.rb|*.erb|*.php|*.cs|*.swift|*.dart|*.lua|*.zig) ;;
  *.java|*.kt|*.scala|*.ex|*.exs)    ;;
  *.c|*.cpp|*.cc|*.h|*.hpp)          ;;
  *.vue|*.svelte)                    ;;
  *) exit 0 ;;
esac

SPECS_DIR="${CWD}/specs"

block() {
  cat >&2 <<BLOCK
spec-first: blocked edit to ${REL_PATH}

  ${1}

What unlocks this edit:
  1. A spec exists in specs/
  2. Its front matter says  status: approved  (or implementing)
     — set by the approver, not by the author, not by the agent
  3. Its "## File changes" section names ${REL_PATH} (or a directory above it)

  Write one:   /spec [slug]        Emergency: touch .spec-first-bypass
BLOCK
  exit 2
}

[ -d "$SPECS_DIR" ] || block "No specs/ directory."

# ── Collect specs whose status allows building ────────────────────────────
# Only approved and implementing unlock. draft and in-review do not: an
# unreviewed spec is a prompt with extra steps, and a gate that accepts one
# is not a gate.

ACTIVE=""
for f in "$SPECS_DIR"/*.md; do
  [ -e "$f" ] || continue
  st=$(sed -n '1,30p' "$f" | sed -n 's/^status:[[:space:]]*\([a-z-]*\).*/\1/p' | head -1)
  case "$st" in
    approved|implementing) ACTIVE="${ACTIVE}${f}"$'\n' ;;
  esac
done

if [ -z "$ACTIVE" ]; then
  ANY=$(find "$SPECS_DIR" -maxdepth 1 -name '*.md' -print -quit 2>/dev/null)
  if [ -n "$ANY" ]; then
    block "specs/ has specs, but none are approved. Nothing has been signed off."
  fi
  block "specs/ is empty."
fi

# ── The spec must name this file ──────────────────────────────────────────
# Pull every path-shaped token out of the approved specs and test whether one
# of them covers this file. A spec that says "MODIFIED: lib/queue/" covers
# lib/queue/jobs.ts; a spec that only says "lib/queue/jobs.ts" does not cover
# lib/other/thing.ts. Prefix matching is anchored on a path separator, so a
# token can never widen itself into its own parent directory.

MATCH=""
# Extract path-shaped tokens only from the '## File changes' section.
# Scanning the whole spec (the old behaviour) let paths in Known issues, prose
# warnings, and fenced code blocks unlock files those sections merely mentioned
# (finding 1).
TOKENS=$(printf '%s' "$ACTIVE" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  awk '/^## File changes/{found=1;next} /^## /{found=0} found{print}' "$f" 2>/dev/null \
    | grep -oE '[A-Za-z0-9_.@-]+(/[A-Za-z0-9_.@*-]+)+/?'
done | sort -u)

while IFS= read -r t; do
  [ -n "$t" ] || continue
  case "$t" in */) pfx="$t" ;; *) pfx="$t/" ;; esac
  if [ "$REL_PATH" = "${t%/}" ] || [ "$REL_PATH" != "${REL_PATH#"$pfx"}" ]; then
    MATCH="$t"; break
  fi
done <<EOF
$TOKENS
EOF

if [ -z "$MATCH" ]; then
  block "An approved spec exists, but none of them mention this path.
  If this edit belongs to that work, add it to the spec's ## File changes."
fi

exit 0
